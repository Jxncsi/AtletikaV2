<Window x:Class="Atletika.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atletika"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok" Height="820" Width="1440" FontFamily="Segoe UI" FontSize="14">
	<Grid Background="#F3F6FA" Margin="20">
        <Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
			<ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,0,8">
			<TextBlock Text="Atlétikai verseny" FontSize="28" FontWeight="Bold" Foreground="#19324D"/>
			<TextBlock Text="Versenyzők regisztrációja és rajtszámok kiosztása" Foreground="#52657A"/>
        </StackPanel>

		<Border Grid.Row="1" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,10,8">
			<StackPanel>
				<TextBlock Text="Új versenyző" FontSize="13" Margin="0,5,0,0"/>
				<Label Content="Versenyző neve:"/>
				<TextBox x:Name="tbNev" Margin="5, 2"/>
				<Label Content="Versenyszám:"/>
				<ComboBox x:Name="cbVersenySzam" Margin="5, 0">
					<ComboBoxItem Content="100 m"/>
					<ComboBoxItem Content="200 m"/>
					<ComboBoxItem Content="400 m"/>
					<ComboBoxItem Content="800 m"/>
					<ComboBoxItem Content="1500 m"/>
					<ComboBoxItem Content="Távolugrás"/>
					<ComboBoxItem Content="Magasugrás"/>
					<ComboBoxItem Content="Súlylökés"/>
				</ComboBox>

				<StackPanel Orientation="Horizontal">
					<Label Content="Nem:"/>
					<RadioButton x:Name="rbFerfi" GroupName="Nem" Margin="15,0,0,0" Content="Férfi" VerticalContentAlignment="Center"/>
					<RadioButton x:Name="rbNo" GroupName="Nem" Margin="30,0,0,0" Content="Nő" VerticalContentAlignment="Center"/>
				</StackPanel>
				<DockPanel LastChildFill="False">
					<Label Content="Életkor" DockPanel.Dock="Left"/>
					<TextBlock x:Name="txtEletkor" Margin="5,0" VerticalAlignment="Center" Text="{Binding ElementName=sldEletkor, Path=Value, StringFormat={}{0} év}" DockPanel.Dock="Right"/>
				</DockPanel>
				<Slider x:Name="sldEletkor" TickPlacement="BottomRight" Minimum="18" Maximum="90" Value="18" IsSnapToTickEnabled="True" TickFrequency="1"/>
				<DockPanel LastChildFill="False">
					<Label Content="18" DockPanel.Dock="Left"/>
					<Label Content="90" DockPanel.Dock="Right"/>
				</DockPanel>
				<Label Content="Korábbi eredmények"/>
				<CheckBox x:Name="chkOR" Content="Olimpiai csúcs (OR)" Margin="5,0,0,5"/>
				<CheckBox x:Name="chkVR" Content="Világcsúcs (VR)" Margin="5,0,0,5" IsChecked="True"/>
				<CheckBox x:Name="chkER" Content="Európa-csúcs (ER)" Margin="5,0,0,5"/>
				<DockPanel>
					<Label Content="Igényelt rajtszám:" DockPanel.Dock="Left"/>
					<TextBox x:Name="txtRajtszam" Height="32" DockPanel.Dock="Right"/>
				</DockPanel>
				<TextBlock Text="Üres mező: automatikus kiosztás." Margin="5" FontSize="10"/>
				<Button x:Name="btnRegisztral" Click="btnRegisztral_Click" Content="Regisztrál" Height="36" Margin="5" Background="#DDEBFA"/>
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
			<DockPanel LastChildFill="False">
				<TextBlock x:Name="txtSzamlalo" DockPanel.Dock="Left" Text="Látható: 0 / Összesen: 0" VerticalAlignment="Center"/>
				<Button x:Name="btnBetoltes" Height="32" Width="210" Click="Betoltes_Click" DockPanel.Dock="Right" Content="FÁJLBÓL BETÖLTÉS" Margin="8,0,0,0" VerticalAlignment="Center"/>
				<Button x:Name="btnMentes" Height="32" Width="210" Click="Mentes_Click" DockPanel.Dock="Right" Content="FÁJLBA MENTÉS" Margin="0,0,8,0" VerticalAlignment="Center"/>
			</DockPanel>
		</Border>

		<Border Grid.Column="1" Grid.Row="1" BorderBrush="#D4DDE7" BorderThickness="1" CornerRadius="8" Padding="16" Margin="10,8,0,8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Label Content="Regisztrált versenyzők" FontWeight="Bold" FontSize="16"/>
				<DockPanel Grid.Row="1" Margin="0,4,0,8">
					<Label Content="Eredményszűrő:" VerticalAlignment="Center"/>
					<ComboBox x:Name="cmbRekordSzuro" Width="220" HorizontalAlignment="Left" SelectedIndex="0" IsEditable="False" SelectionChanged="Szuro_Valtozott">
						<ComboBoxItem Content="Összes"/>
						<ComboBoxItem Content="OR - olimpiai csúcs"/>
						<ComboBoxItem Content="VR - világcsúcs"/>
						<ComboBoxItem Content="ER - Európa-csúcs"/>
					</ComboBox>
				</DockPanel>
				<DataGrid x:Name="dgVersenyzok" Grid.Row="2" ItemsSource="{Binding Versenyzok, Mode=OneWay}"
						  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
						  HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Single" CanUserReorderColumns="False"
						  RowHeight="32" AlternationCount="2" AlternatingRowBackground="#F4F7FB" GridLinesVisibility="Horizontal"
						  BorderBrush="#D4DDE7">
					<DataGrid.ColumnHeaderStyle>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background" Value="#19324D"/>
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="FontWeight" Value="Bold"/>
							<Setter Property="HorizontalContentAlignment" Value="Center"/>
							<Setter Property="Height" Value="38"/>
						</Style>
					</DataGrid.ColumnHeaderStyle>
					<DataGrid.Columns>
						<DataGridTextColumn Header="Rajtszám" Binding="{Binding Rajtszam, Mode=OneWay}" Width="88"/>
						<DataGridTextColumn Header="Név" Binding="{Binding Nev, Mode=OneWay}" Width="*"/>
						<DataGridTextColumn Header="Versenyszám" Binding="{Binding Versenyszam, Mode=OneWay}" Width="160"/>
						<DataGridTextColumn Header="Nem" Binding="{Binding Nem, Mode=OneWay}" Width="70"/>
						<DataGridTextColumn Header="Életkor" Binding="{Binding Eletkor, Mode=OneWay}" Width="80"/>
						<DataGridCheckBoxColumn Header="OR" Binding="{Binding OR, Mode=OneWay}" Width="80"/>
						<DataGridCheckBoxColumn Header="VR" Binding="{Binding VR, Mode=OneWay}" Width="80"/>
						<DataGridCheckBoxColumn Header="ER" Binding="{Binding ER, Mode=OneWay}" Width="80"/>
					</DataGrid.Columns>
				</DataGrid>
				<Label Grid.Row="3" Content="OR = olimpiai csúcs   VR = világcsúcs   ER = Európa-csúcs" FontSize="11"/>
			</Grid>
		</Border>
    </Grid>
</Window>
